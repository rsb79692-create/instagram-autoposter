# =============================================
# Instagram Autoposter - 環境変数設定ファイル
# =============================================
# このファイルを .env.local にコピーして値を設定してください
# cp .env.example .env.local

# ---- Supabase ----
# Supabase ダッシュボード > Settings > API で確認
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---- OpenAI ----
# https://platform.openai.com/api-keys で取得
OPENAI_API_KEY=sk-proj-...

# ---- Instagram / Meta ----
# Meta for Developers > アプリ > Instagram Basic Display API で取得
# 詳細は README を参照
INSTAGRAM_BUSINESS_ACCOUNT_ID=17841400000000000
INSTAGRAM_ACCESS_TOKEN=***REMOVED***
# ---- 管理者認証 ----
# 自分で決めたパスワードを設定（英数字推奨）
ADMIN_PASSWORD=your-secure-password-here

# ---- アプリ設定 ----
# Vercelデプロイ後のURL (ローカルでは http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000
SESSION_SECRET=your-random-secret-string-at-least-32-chars
